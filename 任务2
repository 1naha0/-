import cv2
import numpy as np

#  一. 读取图片 
img_path = 'image.png'  # 替换成你的图片路径
img = cv2.imread(img_path)
if img is None:
    print(" 图片读取失败，请检查路径")
    exit()
output = img.copy()

# 二. 颜色分割：精准提取灯条（缩小范围，避免背景） 
hsv = cv2.cvtColor(img, cv2.COLOR_BGR2HSV)
cv2.imshow("1", hsv)
cv2.waitKey(0)

# 只针对灯条的亮白+偏蓝区域，缩小范围，避免背景的白色/黄色物体
# 1. 亮白色灯条（更严格的范围）
lower_white = np.array([0, 0, 220])  # 提高亮度下限，过滤掉背景的浅色物体
upper_white = np.array([180, 60, 255])
mask_white = cv2.inRange(hsv, lower_white, upper_white)

# 2. 偏蓝色灯条（更严格的范围）
lower_blue = np.array([95, 120, 200])
upper_blue = np.array([125, 255, 255])
mask_blue = cv2.inRange(hsv, lower_blue, upper_blue)

# 合并mask
mask = cv2.bitwise_or(mask_white, mask_blue)
cv2.imshow("2", mask)
cv2.waitKey(0)

# 形态学操作：只保留灯条这种连续、大块的亮区，过滤掉零散噪点
kernel = np.ones((7, 7), np.uint8)
mask = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, kernel, iterations=2)
mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, kernel, iterations=1)

cv2.imshow("3mask", mask)

#  三. 轮廓检测 + 严格筛选 
contours, _ = cv2.findContours(mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)

target_contours = []
for cnt in contours:
    area = cv2.contourArea(cnt)
    # 灯条的面积范围（根据你的图片，灯条面积在500~2500之间）
    if 500 < area < 2500:
        # 多边形拟合，只保留L形灯条（顶点数4~6）
        peri = cv2.arcLength(cnt, True)
        approx = cv2.approxPolyDP(cnt, 0.04 * peri, True)
        if 4 <= len(approx) <= 6:
            # 额外增加：灯条的宽高比筛选（L形灯条的宽高比不会太小）
            rect = cv2.minAreaRect(cnt)
            (w, h) = rect[1]
            if min(w, h) > 30:  # 过滤掉太细、太小的背景物体
                target_contours.append(cnt)

print(f" 找到 {len(target_contours)} 个目标灯条")

#  四. 绘制轮廓 + 最小框选 
for cnt in target_contours:
    # 1. 绘制灯条轮廓（绿色）
    cv2.drawContours(output, [cnt], -1, (0, 255, 0), 2)

    # 2. 绘制最小外接矩形（红色，实现最小框选）
    rect = cv2.minAreaRect(cnt)
    box = cv2.boxPoints(rect)
    box = np.int32(box)
    cv2.drawContours(output, [box], 0, (0, 0, 255), 2)

#五. 显示结果 
cv2.imshow("只框4个灯条", output)
cv2.waitKey(0)
cv2.destroyAllWindows()
