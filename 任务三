import cv2
import numpy as np

# ========== 世界坐标：矩形平放在水平面，长边X，短边Z，Y向上 ==========
L, W = 15.0, 10.0   # 长15cm，宽10cm
world_pts = np.array([
    [-L/2, 0, -W/2],   # 左下
    [ L/2, 0, -W/2],   # 右下
    [ L/2, 0,  W/2],   # 右上
    [-L/2, 0,  W/2]    # 左上
], dtype=np.float64)

# ========== 相机内参（640x480，通用值，无需标定） ==========
w, h = 640, 480
fx = fy = 650.0
cx, cy = w/2, h/2
camera_matrix = np.array([[fx, 0, cx], [0, fy, cy], [0, 0, 1]], dtype=np.float64)
dist = np.zeros(5)

# ========== 角点排序：左下 → 右下 → 右上 → 左上 ==========
def order_corners(pts):
    pts = pts.reshape(4, 2).astype(np.float32)
    center = np.mean(pts, axis=0)
    angles = np.arctan2(pts[:,1]-center[1], pts[:,0]-center[0])
    sorted_pts = pts[np.argsort(angles)]
    sum_xy = sorted_pts[:,0] + sorted_pts[:,1]
    top_left_idx = np.argmin(sum_xy)
    reordered = np.roll(sorted_pts, -top_left_idx, axis=0)
    clockwise = reordered[[3,2,1,0]]
    return clockwise

# ========== 主程序 ==========
cap = cv2.VideoCapture(0)
cap.set(cv2.CAP_PROP_FRAME_WIDTH, w)
cap.set(cv2.CAP_PROP_FRAME_HEIGHT, h)

cv2.namedWindow('Rect Pose')

# 固定Canny阈值
canny_low = 50
canny_high = 150

# 低通滤波平滑位姿
filtered_rvec = None
alpha = 0.7

while True:
    ret, frame = cap.read()
    if not ret:
        break
    img = frame.copy()
    gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
    blur = cv2.GaussianBlur(gray, (5,5), 0)

    edges = cv2.Canny(blur, canny_low, canny_high)
    edges = cv2.dilate(edges, None, iterations=1)

    contours, _ = cv2.findContours(edges, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)

    found = False
    best_corners = None

    for cnt in contours:
        peri = cv2.arcLength(cnt, True)
        if peri < 100:
            continue
        approx = cv2.approxPolyDP(cnt, 0.02 * peri, True)
        if len(approx) != 4:
            continue
        area = cv2.contourArea(cnt)
        img_area = img.shape[0] * img.shape[1]
        if area < 0.01 * img_area or area > 0.6 * img_area:
            continue
        rect = cv2.minAreaRect(cnt)
        w_rect, h_rect = rect[1]
        if w_rect == 0 or h_rect == 0:
            continue
        aspect = max(w_rect, h_rect) / min(w_rect, h_rect)
        target_aspect = L / W
        if aspect < target_aspect * 0.6 or aspect > target_aspect * 1.8:
            continue
        corners = approx.reshape(4,2).astype(np.float32)
        ordered = order_corners(corners)
        found = True
        best_corners = ordered
        break

    if found and best_corners is not None:
        cv2.drawContours(img, [best_corners.astype(int)], -1, (0,255,0), 2)
        for p in best_corners:
            cv2.circle(img, tuple(p.astype(int)), 4, (0,0,255), -1)

        success, rvec, tvec = cv2.solvePnP(world_pts, best_corners, camera_matrix, dist,
                                           flags=cv2.SOLVEPNP_ITERATIVE)
        if success:
            if filtered_rvec is None:
                filtered_rvec = rvec.copy()
            else:
                filtered_rvec = alpha * filtered_rvec + (1-alpha) * rvec

            axis_pts = np.float32([[0,0,0], [8,0,0], [0,8,0], [0,0,8]]).reshape(-1,3)
            img_pts, _ = cv2.projectPoints(axis_pts, filtered_rvec, tvec, camera_matrix, dist)
            img_pts = img_pts.reshape(-1,2).astype(int)
            origin = tuple(img_pts[0])
            cv2.line(img, origin, tuple(img_pts[1]), (0,0,255), 3)
            cv2.line(img, origin, tuple(img_pts[2]), (0,255,0), 3)
            cv2.line(img, origin, tuple(img_pts[3]), (255,0,0), 3)

    cv2.imshow('Rect Pose', img)
    if cv2.waitKey(1) & 0xFF == ord('q'):
        break

cap.release()
cv2.destroyAllWindows()
